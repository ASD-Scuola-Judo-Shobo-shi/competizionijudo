RewriteEngine On

# Reject unknown hosts before redirects or existing static files can bypass the
# PHP front controller's canonical-host check.
RewriteCond %{HTTP_HOST} !^(?:www\.)?competizionijudo\.it(?::[0-9]{1,5})?$ [NC]
RewriteCond %{HTTP_HOST} !^(?:prod|dev|legacy)\.competizionijudo\.it(?::[0-9]{1,5})?$ [NC]
RewriteRule ^ - [R=400,L]

# =====================================================================
# GLOBAL HTTPS ENFORCEMENT
# Forces all http:// traffic to https:// immediately
# =====================================================================
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} ^prod\.competizionijudo\.it(?::[0-9]{1,5})?$ [NC]
RewriteRule ^ https://www.competizionijudo.it/prod%{REQUEST_URI} [L,R=301]
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} ^dev\.competizionijudo\.it(?::[0-9]{1,5})?$ [NC]
RewriteRule ^ https://www.competizionijudo.it/dev%{REQUEST_URI} [L,R=301]
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} ^legacy\.competizionijudo\.it(?::[0-9]{1,5})?$ [NC]
RewriteRule ^ https://www.competizionijudo.it/legacy%{REQUEST_URI} [L,R=301]
RewriteCond %{HTTPS} off
RewriteRule ^ https://www.competizionijudo.it%{REQUEST_URI} [L,R=301]

# =====================================================================
# BLOCK SENSITIVE INTERNAL RESOURCES
# =====================================================================
# Application artifacts live below /prod, /dev, or /legacy. Match both that
# deployed shape and a directly hosted artifact so existing files never bypass
# the front controller through RewriteCond -f/-d below.
RewriteRule ^(?:(?:prod|dev|legacy)/)?(?:\.git|\.github|config|docs|lang|migrations|routes|scripts|src|tests|var|vendor|views)(?:/|$) - [F,L,NC]
RewriteRule ^(?:(?:prod|dev|legacy)/)?(?:composer\.(?:json|lock)|phpunit\.xml|phpstan\.neon|phpcs\.xml|Makefile|README\.md|REVISION|DEPLOYMENT_(?:MANIFEST\.sha256|TRANSFER_PROTOCOL))$ - [F,L,NC]
RewriteRule ^(?:(?:prod|dev|legacy)/)?\.(?!well-known(?:/|$)) - [F,L,NC]

# =====================================================================
# FRONT CONTROLLER — route everything through index.php
# =====================================================================
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php [QSA,L]

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"
</IfModule>
