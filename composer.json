{
  "name": "competizionijudo/mvc-app",
  "description": "A small MVC application for judo competition registration and administration.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.4",
    "ext-fileinfo": "*",
    "ext-mbstring": "*",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-xml": "*",
    "chillerlan/php-qrcode": "^6.0"
  },
  "require-dev": {
    "ext-pcov": "*",
    "phpstan/phpstan": "^1.12",
    "phpunit/phpunit": "^11.0",
    "squizlabs/php_codesniffer": "^4.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "analyse": "phpstan analyse --debug --memory-limit=256M",
    "athletes:deduplicate": "php scripts/reconcile-duplicate-athletes.php",
    "check": [
      "@quality",
      "@test"
    ],
    "ci": "bash scripts/run-ci.sh",
    "ci:quality": [
      "@dependencies:verify",
      "@workflow:check",
      "@test:migrations",
      "@quality",
      "@test:coverage:changed"
    ],
    "cs": "phpcs --standard=phpcs.xml",
    "dependencies:verify": "composer install --dry-run --prefer-dist --no-interaction --no-progress",
    "deploy:preflight": "bash scripts/deploy-preflight.sh",
    "fix": "phpcbf --standard=phpcs.xml",
    "format": "@fix",
    "hooks:install": "git config core.hooksPath scripts/git-hooks",
    "lint": "@cs",
    "metadata": "composer validate --strict --no-check-lock",
    "quality": [
      "@metadata",
      "@syntax",
      "@cs",
      "@analyse",
      "@security:audit"
    ],
    "security:audit": "composer audit --locked --abandoned=fail",
    "serve": "php -S 0.0.0.0:8080 -t public public/index.php",
    "syntax": "find config lang public routes scripts src tests views -name '*.php' -print0 | xargs -0 -n1 php -l",
    "migrate": "php scripts/run-migrations.php",
    "privacy:purge": "php scripts/purge-expired-data.php",
    "test:migrations": "php scripts/test-migrations.php",
    "test:migrations:prepare": "php scripts/setup-migration-test-database.php",
    "test": "phpunit",
    "test:coverage": "mkdir -p build && php vendor/bin/phpunit --coverage-clover build/coverage.xml",
    "test:coverage:changed": "bash scripts/run-changed-coverage.sh",
    "workflow:check": "bash scripts/check-workflows.sh"
  },
  "config": {
    "allow-plugins": false,
    "sort-packages": true
  }
}
