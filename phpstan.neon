parameters:
  level: 6
  parallel:
    maximumNumberOfProcesses: 1
  paths:
    - src/Core
    - src/Controller
    - src/Model
    - src/Service
    - src/Security
    - src/Presentation
    - src/Validation
    - src/helpers.php
    - src/bootstrap.php
    - public
    - config
    - routes
    - scripts
    - views
    - lang
  ignoreErrors:
    # PDO::commit() throwing can leave the transaction open (e.g. SQLite), so
    # the defensive roll-back guard is required at runtime; PHPStan's PDO stub
    # cannot model commit() as a throwing point.
    -
      identifier: booleanAnd.rightAlwaysFalse
      path: src/Service/AthleteCsvTransfer.php
      reportUnmatched: true
