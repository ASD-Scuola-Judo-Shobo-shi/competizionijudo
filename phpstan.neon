parameters:
  level: 6
  parallel:
    maximumNumberOfProcesses: 1
  paths:
    - src/Core
    - src/Controller
    - src/Model
    - src/Service
    - src/Security
    - src/Presentation
    - src/Validation
    - src/helpers.php
    - src/bootstrap.php
    - public
    - config
    - routes
    - scripts
    - views
    - lang
