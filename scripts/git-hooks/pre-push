#!/usr/bin/env sh
set -eu

ROOT_DIR="$(git rev-parse --show-toplevel)"
cd "$ROOT_DIR"
export COMPOSER_CACHE_DIR="${COMPOSER_CACHE_DIR:-$ROOT_DIR/.cache/composer}"

if [ ! -f vendor/autoload.php ]; then
  echo "pre-push: Composer dependencies are missing; run composer install first." >&2
  exit 1
fi

echo "pre-push: running full local CI"
composer ci
