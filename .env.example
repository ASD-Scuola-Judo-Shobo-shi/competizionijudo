APP_NAME="Competizioni Judo"
APP_ENV=production
APP_DEBUG=false
APP_LOCALE=it
APP_URL=
APP_TEST_RESET_LINKS=false
EVENTS_UPCOMING_LIMIT=12
# Account growth limits for clubs after administrator approval. Set to 0 to
# disable a quota. The athlete limit caps the club archive; the entry limit
# caps the entries a single club can place in one event.
CLUB_ATHLETE_LIMIT=1000
CLUB_ENTRY_LIMIT=1000
# Temporary administrator-only production repair page. Enable only for a
# supervised maintenance window, then set it back to false and redeploy.
ATHLETE_DUPLICATE_MAINTENANCE=false

DB_HOST=127.0.0.1
DB_NAME=
DB_USER=
DB_PASS=

ADMIN_USER=
ADMIN_PASS_HASH=
MIGRATIONS_TOKEN=

# Aruba Linux Basic provides the PHP mail() transport. Its documented site-mail
# sender is the domain postmaster account; no SMTP/API credential is required.
# A future provider can add another PasswordResetMailer adapter and driver name.
PASSWORD_RESET_MAILER=aruba
MAIL_FROM_ADDRESS=postmaster@competizionijudo.it

# Public controller, hosting, and retention facts displayed in the privacy
# notice and footer.
APP_OWNER="ASD Scuola Judo Shòbò-shi"
APP_OWNER_ADDRESS="via Bonorva 4, 09044 Quartucciu CA, Italy"
APP_OWNER_FISCAL_CODE="90015550927"
APP_OWNER_EMAIL="info@competizionijudo.it"
APP_WEBHOST=Aruba
APP_WEBHOST_LOCATION=Italy
APP_LOG_RETENTION_DAYS=30
APP_BACKUP_RETENTION_DAYS=30
